index 0000000..12e5041
--- /dev/null
+++ b/csrc/flash_attn/src/flash_fwd_hdim256_fp16_sm75.cu
@@ -0,0 +1,13 @@
+#include "flash_fwd_launch_template.h"
+
+// Two warps own 16 query rows each. With SEPV the three half tiles
+// occupy 3 * 32 * 256 * 2 = 49152 bytes, including the shared Q/O tile.
+template<>
+void run_mha_fwd_<256, false>(Flash_fwd_params &params) {
+    run_mha_fwd_tile_impl_n<256, 32, 32, 2, false>(params);
+}
+
+template<>
+void run_mha_fwd_<256, true>(Flash_fwd_params &params) {
+    run_mha_fwd_tile_impl_n<256, 32, 32, 2, true>(params);
+}
